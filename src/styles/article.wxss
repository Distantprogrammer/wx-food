.article {
  padding: 8rpx 40rpx calc(220rpx + env(safe-area-inset-bottom));
}

.h2 {
  display: flex;
  align-items: center;
  margin: 60rpx 0 0;
}

.h2-no {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  padding: 0 10rpx;
  border-radius: 14rpx;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.h2-title {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.h2-bar {
  width: 68rpx;
  height: 6rpx;
  margin: 20rpx 0 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #2D6A4F 0%, #40916C 100%);
}

.h3 {
  display: flex;
  align-items: center;
  margin: 44rpx 0 8rpx;
}

.h3-bar {
  flex-shrink: 0;
  width: 8rpx;
  height: 30rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #40916C 0%, #2D6A4F 100%);
}

.h3-title {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.para {
  display: block;
  margin: 20rpx 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 30rpx;
  line-height: 1.85;
  text-align: justify;
}

.strong {
  color: #1B4332;
  font-weight: 700;
}

.ul {
  margin: 12rpx 0;
}

.li {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin: 14rpx 0;
}

.li-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-top: 22rpx;
  margin-right: 16rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: #2D6A4F;
}

.li-text {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 30rpx;
  line-height: 1.85;
  text-align: justify;
}

.ic {
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  background: #F1F3F5;
  color: #0F766E;
  font-size: 25rpx;
  line-height: 40rpx;
}

.mark {
  padding: 0 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 60%, #FFE9A0 40%);
  font-weight: 600;
}

.steps {
  margin: 28rpx 0;
}

.step {
  position: relative;
  display: flex;
  padding-bottom: 32rpx;
}

.step.is-last {
  padding-bottom: 4rpx;
}

.step-line {
  position: absolute;
  left: 25rpx;
  top: 64rpx;
  bottom: 8rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #2D6A4F 0%, rgba(45, 106, 79, 0.12) 100%);
}

.step.is-last .step-line {
  background: transparent;
}

.step-no {
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #E8F3EE;
  box-shadow: 0 0 0 3rpx rgba(45, 106, 79, 0.22);
  color: #2D6A4F;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.step-body {
  flex: 1;
  min-width: 0;
  padding-top: 6rpx;
}

.step-text {
  color: rgba(0, 0, 0, 0.9);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.callout {
  display: flex;
  margin: 32rpx 0;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  border-left-width: 6rpx;
  border-left-style: solid;
}

.callout.info {
  background: #E8F3EE;
  border-left-color: #2D6A4F;
}

.callout.warn {
  background: #FFF7E6;
  border-left-color: #D97A1F;
}

.callout.success {
  background: #E9F7EC;
  border-left-color: #2D8A4E;
}

.callout.note {
  background: #E8F0FF;
  border-left-color: #4A7BD0;
}

.c-i {
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 34rpx;
  line-height: 44rpx;
}

.c-main {
  flex: 1;
  min-width: 0;
}

.c-t {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.callout.info .c-t {
  color: #2D6A4F;
}

.callout.warn .c-t {
  color: #D97A1F;
}

.callout.success .c-t {
  color: #2D8A4E;
}

.callout.note .c-t {
  color: #4A7BD0;
}

.c-d {
  display: block;
  margin-top: 6rpx;
  color: rgba(0, 0, 0, 0.75);
  font-size: 27rpx;
  line-height: 1.75;
  text-align: justify;
}

.formula {
  position: relative;
  margin: 36rpx 0 28rpx;
  padding: 36rpx 32rpx 20rpx;
  background: #FBFCFD;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 28rpx;
}

.f-tag {
  position: absolute;
  top: -18rpx;
  left: 28rpx;
  padding: 5rpx 20rpx;
  border-radius: 16rpx;
  background: #2D6A4F;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.f-row {
  display: block;
  color: #1F2937;
  font-family: Georgia, serif;
  font-size: 33rpx;
  font-style: italic;
  line-height: 2.05;
  text-align: center;
}

.code {
  margin: 28rpx 0;
  overflow: hidden;
  background: #1F2733;
  border-radius: 28rpx;
}

.code-bar {
  display: flex;
  align-items: center;
  padding: 18rpx 26rpx;
  background: rgba(255, 255, 255, 0.05);
}

.code-dots {
  display: flex;
  align-items: center;
}

.code-dot {
  width: 18rpx;
  height: 18rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.code-dot.red {
  background: #FF5F57;
}

.code-dot.yellow {
  background: #FEBC2E;
}

.code-dot.green {
  background: #28C840;
}

.code-name {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  overflow: hidden;
  color: #8B93A7;
  font-size: 22rpx;
  line-height: 36rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.code-copy {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.07);
  color: #7FC8A9;
  font-size: 22rpx;
  line-height: 36rpx;
}

.code-body {
  display: block;
  padding: 26rpx 30rpx;
  color: #C8D3E0;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.kw {
  color: #7AA2F7;
}

.fn {
  color: #E0AF68;
}

.num {
  color: #FF9E64;
}

.table-card {
  margin: 28rpx 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.table-scroll {
  width: 100%;
}

.table {
  display: table;
  min-width: 100%;
}

.tr {
  display: table-row;
}

.th,
.td {
  display: table-cell;
  min-width: 160rpx;
  padding: 18rpx 22rpx;
  color: rgba(0, 0, 0, 0.9);
  font-size: 25rpx;
  line-height: 1.55;
  white-space: nowrap;
}

.th {
  background: #E8F3EE;
  color: #2D6A4F;
  font-weight: 700;
  text-align: left;
}

.td {
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.figure {
  margin: 28rpx 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.figure-img {
  display: block;
  width: 100%;
}

.figure-cap {
  display: block;
  padding: 16rpx 24rpx;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  color: rgba(0, 0, 0, 0.55);
  font-size: 23rpx;
  line-height: 36rpx;
}

.qa {
  margin: 20rpx 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04), 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.qa-q {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
}

.qa-label {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 14rpx;
  background: #FFE9A0;
  color: #8A6A1F;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.qa-text {
  flex: 1;
  min-width: 0;
  color: rgba(0, 0, 0, 0.9);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.qa-caret {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-left: 16rpx;
  border-right: 4rpx solid rgba(0, 0, 0, 0.32);
  border-bottom: 4rpx solid rgba(0, 0, 0, 0.32);
  transform: rotate(45deg);
}

.qa.is-open .qa-caret {
  margin-top: 8rpx;
  transform: rotate(-135deg);
}

.qa-a {
  display: block;
  padding: 0 28rpx 26rpx 92rpx;
  color: rgba(0, 0, 0, 0.55);
  font-size: 26rpx;
  line-height: 1.75;
  text-align: justify;
}

.end-sign {
  margin-top: 52rpx;
  color: rgba(0, 0, 0, 0.32);
  font-size: 24rpx;
  letter-spacing: 8rpx;
  text-align: center;
}
